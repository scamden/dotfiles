#!/bin/zsh

system_type=$(uname -s)

# Here we make sure YADM & VSCode play nice by making sure '**' is in
# $GIT_DIR/info/exclude.
yadm gitconfig advice.addIgnoredFile false
GIT_DIR="$HOME/.local/share/yadm/repo.git"
if [ -d "$GIT_DIR" ] && ! grep "^\*\*$" "$GIT_DIR/info/exclude" >/dev/null 2>&1; then
  echo "**" >> "$GIT_DIR/info/exclude"
fi


if [ "$system_type" = "Darwin" ]; then

  # install homebrew if it's missing
  if ! command -v brew >/dev/null 2>&1; then
    echo "Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi

  BREWFILE="${HOMEBREW_BUNDLE_FILE:-$HOME/.Brewfile}"
  if [ -f "$BREWFILE" ]; then
    echo "Updating Homebrew bundle"
    brew bundle --file="$BREWFILE"
  fi

fi

if [ "$system_type" = "Darwin" ]; then

  # possibly add something here to ensure iTerm2 is installed using Homebrew
  # cask like in the previous example

  if [ -d "$HOME/.config/iterm" ]; then
    echo "Setting iTerm preference folder"
    defaults write com.googlecode.iterm2 PrefsCustomFolder "$HOME/.config/iterm"
    defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
  fi

fi

if command -v mise >/dev/null 2>&1; then
  echo "Installing mise tools"
  mise install
else
  echo "mise is not installed; install it with Homebrew and rerun bootstrap" >&2
fi

install_whisper_model() {
  local model_dir="$HOME/.local/share/whisper-cpp/models"
  local model_path="$model_dir/ggml-base.en.bin"
  local model_url="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin"

  if ! command -v whisper-cli >/dev/null 2>&1; then
    echo "whisper-cli is not installed; install whisper-cpp with Homebrew and rerun bootstrap" >&2
    return 0
  fi

  if [ -s "$model_path" ]; then
    return 0
  fi

  echo "Installing Whisper base English model"
  mkdir -p "$model_dir"
  curl -fL "$model_url" -o "$model_path.tmp" && mv "$model_path.tmp" "$model_path"
}

install_whisper_model

install_local_bin_symlink() {
  local source_path="$1"
  local target_path="$2"

  mkdir -p "$(dirname "$target_path")"

  if [ -L "$target_path" ]; then
    if [ "$(readlink "$target_path")" = "$source_path" ]; then
      return 0
    fi

    ln -sfn "$source_path" "$target_path"
    return $?
  fi

  if [ -e "$target_path" ]; then
    echo "Skipping $target_path; expected symlink target but found an existing file." >&2
    return 0
  fi

  ln -s "$source_path" "$target_path"
}

install_local_bin_symlink "$HOME/.config/yadm/bin/newbranch" "$HOME/.local/bin/newbranch"
install_local_bin_symlink "$HOME/.config/yadm/bin/prefixed-git-branch" "$HOME/.local/bin/prefixed-git-branch"
install_local_bin_symlink "$HOME/.config/yadm/bin/transcribe" "$HOME/.local/bin/transcribe"

echo "Updating the yadm repo origin URL"
yadm remote set-url origin "git@github.com:scamden/dotfiles.git"
