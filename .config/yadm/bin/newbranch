#!/bin/sh

# Branch layout is derived from git history by git-branch-tree, so creating a branch no
# longer has to register it anywhere.

if [ -z "$1" ]; then
  echo "Usage: newbranch <branch-name>"
  exit 1
fi

if ! command -v prefixed-git-branch >/dev/null 2>&1; then
  echo "Cannot find prefixed-git-branch on PATH."
  exit 1
fi

exec prefixed-git-branch "$1"
