#!/bin/zsh
set -euo pipefail

model_path="${WHISPER_CPP_MODEL:-$HOME/.local/share/whisper-cpp/models/ggml-base.en.bin}"

usage() {
  cat >&2 <<'USAGE'
Usage: transcribe INPUT [OUTPUT_BASENAME]

Transcribes audio or video with whisper-cpp.
OUTPUT_BASENAME omits the extension; .txt is added by whisper-cli.
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  usage
  exit 2
fi

input_path="$1"
if [ ! -f "$input_path" ]; then
  echo "Input file not found: $input_path" >&2
  exit 1
fi

if ! command -v whisper-cli >/dev/null 2>&1; then
  echo "whisper-cli not found. Install it with: brew install whisper-cpp" >&2
  exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "ffmpeg not found. Install it with: brew install ffmpeg" >&2
  exit 1
fi

if [ ! -s "$model_path" ]; then
  echo "Whisper model not found: $model_path" >&2
  echo "Run yadm bootstrap or download ggml-base.en.bin to that path." >&2
  exit 1
fi

input_dir="$(dirname "$input_path")"
input_name="$(basename "$input_path")"
input_stem="${input_name%.*}"
output_base="${2:-$input_dir/$input_stem.transcript}"
audio_path="$input_path"
temp_audio=""

case "${input_path:l}" in
  *.wav|*.flac|*.mp3|*.ogg)
    ;;
  *)
    temp_audio="$(mktemp -t transcribe.XXXXXX).wav"
    ffmpeg -y -v error -i "$input_path" -vn -ac 1 -ar 16000 "$temp_audio"
    audio_path="$temp_audio"
    ;;
esac

cleanup() {
  if [ -n "$temp_audio" ] && [ -f "$temp_audio" ]; then
    rm -f "$temp_audio"
  fi
}
trap cleanup EXIT

whisper-cli -ng -m "$model_path" -f "$audio_path" -otxt -of "$output_base"
echo "$output_base.txt"
