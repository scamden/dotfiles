choose_machete_branch() {
  git machete status --color=always --squash-merge-detection=none \
  | awk '
    {
      line = $0
      plain = $0
      gsub(/\x1B\[[0-9;]*[mK]/, "", plain)
      sub(/^[[:space:]]+/, "", plain)
      sub(/^[|│├└─ ]+/, "", plain)
      sub(/^[omx?]-/, "", plain)

      branch = plain
      sub(/[[:space:]].*$/, "", branch)

      if (branch != "") {
        print branch "\t" line
      }
    }
  ' \
  | fzf --ansi --tac \
        --delimiter=$'\t' \
        --with-nth=2.. \
        --header="Checkout (git machete tree)" \
        --preview='git diff {1} --color=always' \
  | cut -f1
}

function co() {
  local branch
  if [ -n "$1" ]; then
    branch="$1"
  else
    # swap this line back to choose_branch if you want the old mode sometimes
    branch="$(choose_machete_branch)"
  fi

  if [ -n "$branch" ]; then
    git checkout "$branch"
    print -s "git checkout \"$branch\""
  fi
}


